{
  "expo": {
    "name": "Peak",
    "slug": "Peak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/peak-icon.png",
    "scheme": "peak",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/peak-icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.anhhaonguyen.peak"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.anhhaonguyen.peak",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/peak-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/peak-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/SF-Pro-Rounded-Black.otf",
            "./src/assets/fonts/SF-Pro-Rounded-Bold.otf",
            "./src/assets/fonts/SF-Pro-Rounded-Heavy.otf",
            "./src/assets/fonts/SF-Pro-Rounded-Light.otf",
            "./src/assets/fonts/SF-Pro-Rounded-Medium.otf",
            "./src/assets/fonts/SF-Pro-Rounded-Regular.otf",
            "./src/assets/fonts/SF-Pro-Rounded-Semibold.otf",
            "./src/assets/fonts/SF-Pro-Rounded-Thin.otf",
            "./src/assets/fonts/SF-Pro-Rounded-Ultralight.otf"
          ]
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
